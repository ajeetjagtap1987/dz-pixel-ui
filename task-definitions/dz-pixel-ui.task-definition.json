{
  "family": "td-ui-svc",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::182086865009:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::182086865009:role/pixel-task-role",
  "containerDefinitions": [
    {
      "name": "ui",
      "image": "PLACEHOLDER_REPLACED_BY_WORKFLOW",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "DASHBOARD_URL", "value": "https://api.pixel.example.com" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/pixel-prod",
          "awslogs-region":        "ap-south-1",
          "awslogs-stream-prefix": "ui",
          "awslogs-create-group":  "true"
        }
      },
      "healthCheck": {
        "command":     ["CMD-SHELL", "wget -qO- http://localhost:8080/healthz || exit 1"],
        "interval":    30,
        "timeout":     5,
        "retries":     3,
        "startPeriod": 15
      }
    }
  ]
}
